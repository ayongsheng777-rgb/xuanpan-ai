# npm registry 配置说明（2026-10-08 更新）：
#
# 之前这里写死了国内镜像（registry.npmmirror.com），是因为用户本机直连
# registry.npmjs.org 不通。但 EAS 云构建机在国外，直连官方源没问题，
# 用国内镜像反而导致 eas-cli@24.12.1 装不上（镜像没同步最新版），
# 构建在 Prepare project 阶段直接失败。
#
# 现在构建走 EAS 云端，不再依赖本机 npm，所以删掉 registry 行，
# 让构建机用官方源。如果以后要在本机跑 npm install，再手动加回来：
# registry=https://registry.npmmirror.com

# Expo / React Native 的部分二进制走各家的 CDN，一并指向镜像，避免卡在下载。
# （Expo 自带的包多且体积大，这一条能显著缩短首次安装时间）
fund=false
audit=false
