# npm registry 走国内镜像。
#
# 为什么必须写死在项目里：`registry.npmjs.org` 在本机**不可达**（实测 curl 返回 000），
# 用默认源装依赖会停在依赖解析阶段十几分钟没有任何输出，且不报错 ——
# 症状是"命令在跑但 node_modules 一直不出现"，很容易被误判成"Expo 依赖本来就大"。
# 实测 registry.npmmirror.com 返回 200、耗时 0.14s。
registry=https://registry.npmmirror.com

# Expo / React Native 的部分二进制走各家的 CDN，一并指向镜像，避免卡在下载。
# （Expo 自带的包多且体积大，这一条能显著缩短首次安装时间）
fund=false
audit=false
