{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    // 允许在 import 里写显式 `.ts` 后缀 —— 这是 Node 的 ESM/TS 载入器要求的写法，
    // 而 `scripts/*_probe.ts` 要能被 `node --experimental-strip-types` 直接执行。
    // 只有 `src/lib/compassDial.ts` 用了这种写法（它被探针导入且自身又导入 ring24）；
    // 其余源码仍是免后缀风格。tsc 只做类型检查（noEmit），不进构建产物。
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["react", "react-native"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // scripts/ 是给 Node 直接执行（--experimental-strip-types）的校验探针，
  // 它们按 Node ESM 要求**显式带 .ts 后缀**导入模块，而 tsc 默认禁止这种写法
  // （allowImportingTsExtensions）。这些文件不进 Metro 打包，单独排除即可。
  "exclude": ["node_modules", "dist", ".expo", "scripts"]
}
