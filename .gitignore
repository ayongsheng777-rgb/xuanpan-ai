# ============================================
# 玄盘 AI — .gitignore
# 依据 AGENTS.md §5.1 目录结构与 §6 红线制定
# ============================================

# ---- 密钥与环境（最高优先级，绝不提交）----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
.coverage.*
dist/
build/

# ---- Node / React Native / Expo ----
node_modules/
.expo/
.expo-shared/
dist/
build/
web-build/
*.tsbuildinfo

# expo web 静态产物（`npx expo export --platform web` 的默认去向，
# 也是 tests/mobile/test_ui_render.py 的输入）。属可再生产物，不入库。
dist-web/
.next/
.npm/
.metro-health-check*

# ---- Expo prebuild 派生目录 ----
# app.json / app.config.js 是唯一配置源，android/ 与 ios/ 由
# `npx expo prebuild` 生成，属派生产物（同 dist/ 的性质）。
# 提交它们等于把同一份配置存两处：改了 app.json 却忘了重新 prebuild，
# 就会得到一个「配置写了但没生效」的原生工程，且极难察觉。
# 需要自定义原生代码时，改用 config plugin 而不是直接改这里。
apps/mobile/android/
apps/mobile/ios/
# prebuild 生成的本地 SDK 路径，含机器专属信息
apps/mobile/android/local.properties

# ---- 日志 ----
*.log
logs/
npm-debug.log*
yarn-error.log*

# ---- 系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ---- 本地临时（AI 工作区，memory 需提交故不整体忽略）----
.workbuddy/tmp/
*.tmp

# ---- 运行时数据（不进版本库）----
# 根 data/ 只装运行时产物：SQLite 库、上传原件、缓存。
# ⚠️ 领域数据表**不在这里** —— fenjin120.py / naming.py / qian.py 的默认路径
#    全部指向 packages/fortune-core/data/（随包提交）。此前注释写的是
#    「data/compass、data/qian、data/naming 等『领域数据』必须提交」，
#    与实际不符：它会让人以为根 data/ 是有效数据路径，而它只是运行时目录。
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/uploads/
data/cache/
data/tmp/

# ---- 测试样张 ----
# 由 scripts/gen_sample_photos.py 生成，可随时重建。
# 它们是合成图，只用于验证「APP ↔ 后端」链路，本身没有版本价值；
# 真正需要留档的是生成脚本与 Gate 1 的实测报告。
samples/
