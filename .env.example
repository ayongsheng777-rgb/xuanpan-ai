# ============================================
# 玄盘 AI — 环境变量样例
# ============================================
#
# 用法：复制为 .env 后按需填写。
#
#     cp .env.example .env
#
# 本文件是**穷尽式**的：后端实际读取的全部 17 个环境变量都在这里。
# 新增变量时必须同步更新本文件，否则部署时会静默走默认值 —— 而"默认值"
# 与"我配了但没生效"在现象上完全一样，很难排查。
# （唯一真源：services/api/xuanpan_api/config.py、services/ai/xuanpan_ai/router.py、
#   services/vision/xuanpan_vision/providers/openai_compat.py、__main__.py）
#
# ⚠️ 计费声明（AGENTS.md §5.4）：下面标 [按量计费] 的两项需要自备 API key，
#    是本项目唯二的变动成本项。**不填 = 走零成本路径**，功能不会报错，
#    只会降级（见各自注释）。填了就开始产生费用，请自行评估。
#
# 红线：.env 与 data/ 属重建禁区，永不进版本库（.gitignore / .dockerignore 均已覆盖）。

# ---------------------------------------------------------------
# 一、服务进程（[Host] python -m xuanpan_api 生效；uvicorn 直接调 create_app 时不读）
# ---------------------------------------------------------------

# 监听地址。容器内必须是 0.0.0.0，否则宿主访问不到。
XUANPAN_HOST=127.0.0.1

# 监听端口。默认 8352，但⚠️ 本机 8352 已被 SysCenter 占用，
# 本地联调统一用 8360（见 AGENTS.md §5.3）。
XUANPAN_PORT=8360

# 是否开启热重载。仅开发用；生产必须为空或 false。
XUANPAN_RELOAD=

# ---------------------------------------------------------------
# 二、后端服务（config.py）
# ---------------------------------------------------------------

# SQLite 库路径。留空 = <cwd>/data/xuanpan.db
# 容器内由 Dockerfile 固定为 /app/data/xuanpan.db（该目录挂卷）。
XUANPAN_DB_PATH=

# 上传图片体积上限（MB）。超大图对识别没有帮助，只会拖慢链路。
XUANPAN_MAX_UPLOAD_MB=12

# 【隐私开关】识别完成后是否长期保留原图。
# 默认 false —— 原图只在内存里过一遍，落库的只有结构化识别结果。
# ⚠️ 改成 true 之后，产品内的隐私说明措辞必须同步修改，否则就成了假承诺。
#    对应断言：tests/api/test_api.py::TestScan::test_scan_does_not_persist_photo
XUANPAN_KEEP_PHOTOS=false

# 原图落盘目录，**仅当 KEEP_PHOTOS=true 时使用**。留空 = <cwd>/data/uploads
XUANPAN_PHOTO_DIR=

# AI 路由模式，三选一：auto / cost / quality
#   auto    —— 报告走质量优先，追问走省钱优先（默认）
#   cost    —— 一律先挑便宜的
#   quality —— 一律先挑能力强的
# 非法值会记一条 warning 并回退 auto，不会启动失败。
XUANPAN_AI_MODE=auto

# CORS 允许来源，逗号分隔。生产应由网关收敛，不要留 *
XUANPAN_CORS_ORIGINS=*

# 【管理界面令牌】留空 = 管理界面**关闭**。
#
# 为什么默认关闭：管理台（/admin）会列出全部会话记录，其中含用户生辰、坐向等
# 隐私数据，而容器部署时宿主端口通常是对外映射的。默认开放等于把它们放到公网上。
# 未配置时 /api/v1/admin/* 一律返回 403，并在响应里给出配置指引（不是静默 404）。
#
# 生成（[Host]）：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# 访问：
#   http://127.0.0.1:8360/admin?token=<上一步生成的值>
# 页面只把令牌存进 sessionStorage（关闭标签即失效），并从地址栏抹掉它。
XUANPAN_ADMIN_TOKEN=

# ---------------------------------------------------------------
# 三、AI 解释层（services/ai）—— [按量计费]
# ---------------------------------------------------------------
# 下面三项**必须同时填**才会启用云端解释。三者缺任意一个，路由链里就只剩
# 本地模板（零成本、离线可用、内容较简短），不会报错。
# 三件套齐全时：主候选为云端模型，本地模板仍排在最后兜底 ——
# 云端失败会自动降级，降级不影响任何计算结果（RULE-002）。

# OpenAI 兼容协议的 base_url，例如：
#   https://api.deepseek.com/v1        （DeepSeek）
#   https://dashscope.aliyuncs.com/compatible-mode/v1  （通义千问）
# 优先国内直连线路，避免跨境链路依赖（生产路线报告 §6）。
XUANPAN_LLM_BASE_URL=

# ⚠️ 密钥。绝不提交，绝不进镜像，绝不进客户端。
# API Key 只存在于服务端环境变量 —— 客户端拿不到（设计规范 §27）。
XUANPAN_LLM_API_KEY=

XUANPAN_LLM_MODEL=

# 该模型的能力标签，用于路由排序：reasoning（默认）/ fast / local
# ⚠️ 别写 vision 之类的自定义值：不在排序表里的标签会**静默**落到默认档（等同 local），
#    不报错、也不生效 —— 你以为调了优先级，实际没变。
#    排序表见 services/ai/xuanpan_ai/router.py::_capability_rank
XUANPAN_LLM_CAPABILITY=reasoning

# ---------------------------------------------------------------
# 以下配置项均可由管理台（/admin → 配置）在运行时覆盖，无需重启：
#   ai_mode / keep_photos / max_upload_mb / llm.*
# 优先级：管理台覆盖 > 本文件的环境变量 > 代码默认值。
# 「改了这里却没变化」时先去 /api/v1/admin/config 看 source 是不是
# 「管理台覆盖」—— 是的话清掉覆盖即可回落本文件。
# cors_origins 与 admin_token 例外：启动阶段被读取，改完需重启。
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# 四、视觉识别层（services/vision）—— [按量计费]
# ---------------------------------------------------------------
# 默认走本地 CV（classical，零成本），云端视觉是**显式开启**的：
# 调用时带 ?provider=openai_compat 才用。
# 未配置 XUANPAN_VISION_API_KEY 时该 provider 的 is_available() 为 False，
# 显式调用会得到明确的"环境不可用"，而不是静默失败。
#
# 成本提示：视觉调用是本项目**最大**成本项。开启前先想清楚调用量。

XUANPAN_VISION_API_KEY=

# 留空 = https://api.openai.com/v1
XUANPAN_VISION_BASE_URL=

# 留空 = gpt-4o-mini
XUANPAN_VISION_MODEL=
